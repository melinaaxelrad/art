rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts collection
    match /posts/{postId} {
      // Allow public read access
      allow read: if true;
      
      // Allow write only if authenticated and email matches admin email
      allow write: if request.auth != null 
                   && request.auth.token.email == "melinaaxelrad@gmail.com";
    }
  }
}

